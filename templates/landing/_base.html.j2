{# Pantra landing — base layout.
   Inherits Duna design system (docs/design/duna/DESIGN.md).
   Copy is served from per-locale catalogs in templates/landing/i18n/<lang>/;
   templates reference strings via {{ t('namespace.key') }}. German is the
   default language, English the alternate (see src/pantra/api/i18n.py). #}
<!DOCTYPE html>
<html lang="{{ html_lang | default('de') }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% block title %}{{ t('common.meta.title') }}{% endblock %}</title>
  <meta name="description" content="{% block meta_description %}{{ t('common.meta.description') }}{% endblock %}">

  {# Canonical + hreflang alternates so DE and EN are indexed as one page in
     two languages rather than duplicate content. #}
  <link rel="canonical" href="{{ request.url.scheme }}://{{ request.url.netloc }}{{ request.url.path }}">
  {% for lang in SUPPORTED_LANGS %}
  <link rel="alternate" hreflang="{{ lang }}" href="{{ request.url.scheme }}://{{ request.url.netloc }}{{ request.url.path }}?lang={{ lang }}">
  {% endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ request.url.scheme }}://{{ request.url.netloc }}{{ request.url.path }}">

  {# OpenGraph / Twitter #}
  <meta property="og:title" content="{{ t('common.meta.og_title') }}">
  <meta property="og:description" content="{{ t('common.meta.og_description') }}">
  <meta property="og:locale" content="{{ OG_LOCALE[html_lang] | default('de_DE') }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ request.url.scheme }}://{{ request.url.netloc }}{{ request.url.path }}">

  {# Manrope + Inter — self-hosted from /static/landing/fonts to keep the
     landing DSGVO-clean (no Google Fonts CDN call). Subsets latin +
     latin-ext bundled — covers DE, EN, ES, TR (with diacritics), FR, IT, PT. #}
  <link rel="stylesheet" href="/static/landing/fonts.css">
  <link rel="stylesheet" href="/static/landing/style.css">

  {# JSON-LD schema.org for SEO. #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Pantra",
    "applicationCategory": "BusinessApplication",
    "operatingSystem": "Web-based",
    "offers": {
      "@type": "Offer",
      "price": "349",
      "priceCurrency": "EUR",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": "349",
        "priceCurrency": "EUR",
        "billingDuration": "P1M"
      }
    },
    "areaServed": "DE",
    "audience": {
      "@type": "BusinessAudience",
      "audienceType": "Dental practices"
    }
  }
  </script>
</head>
<body>

<nav class="nav">
  <a href="/einzelpraxis" class="nav-brand">Pantra</a>
  <button class="nav-toggle" type="button" aria-label="{{ t('common.nav.menu') }}"
          aria-expanded="false" aria-controls="nav-links">
    <span class="nav-toggle-bar"></span>
    <span class="nav-toggle-bar"></span>
    <span class="nav-toggle-bar"></span>
  </button>
  <ul class="nav-links" id="nav-links">
    {# Absolute paths so the nav works across both /einzelpraxis and /pricing. #}
    <li><a href="/einzelpraxis#features">{{ t('common.nav.features') }}</a></li>
    <li><a href="/pricing">{{ t('common.nav.pricing') }}</a></li>
    <li><a href="/einzelpraxis#faq">{{ t('common.nav.faq') }}</a></li>
  </ul>
  <div class="nav-cta-wrap">
    <span class="nav-lang">
      <a href="?lang=de" class="{% if html_lang == 'de' %}active{% endif %}">DE</a>
      <a href="?lang=en" class="{% if html_lang == 'en' %}active{% endif %}">EN</a>
    </span>
    <a href="#get-started" class="btn-primary sm">{{ t('common.nav.cta_trial') }}</a>
  </div>
</nav>

{% block content %}{% endblock %}

<footer class="footer">
  <div class="footer-content">
    <div class="footer-grid">
      <div class="footer-brand-col">
        <div class="footer-brand">Pantra</div>
        <p class="footer-brand-tag">{{ t('common.footer.brand_tag') }}</p>
      </div>
      <div class="footer-col">
        <h4>{{ t('common.footer.col_product') }}</h4>
        <ul>
          <li><a href="/einzelpraxis#features">{{ t('common.footer.product_features') }}</a></li>
          <li><a href="/pricing">{{ t('common.footer.product_pricing') }}</a></li>
          <li><a href="/demo">{{ t('common.footer.product_demo') }}</a></li>
          <li><a href="/einzelpraxis#faq">{{ t('common.footer.product_faq') }}</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>{{ t('common.footer.col_legal') }}</h4>
        <ul>
          {# /avv page is pending the lawyer's AVV (see docs/AVV_LAWYER_BRIEF.md);
             until it exists the data-processing topic lives under /datenschutz. #}
          <li><a href="/impressum">{{ t('common.footer.legal_impressum') }}</a></li>
          <li><a href="/datenschutz">{{ t('common.footer.legal_datenschutz') }}</a></li>
          <li><a href="/agb">{{ t('common.footer.legal_agb') }}</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>{{ t('common.footer.col_contact') }}</h4>
        <ul>
          <li><a href="mailto:hallo@pantra.de">hallo@pantra.de</a></li>
          <li><a href="#get-started">{{ t('common.footer.contact_demo') }}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-base">
      <span>{{ t('common.footer.copyright') }}</span>
      <span>{{ t('common.footer.trust_line') }}</span>
    </div>
  </div>
  <div class="footer-watercolor" aria-hidden="true"></div>
</footer>

<script>
  // Mobile nav: hamburger toggles the links dropdown (see .nav-toggle CSS).
  (function () {
    var toggle = document.querySelector('.nav-toggle');
    var nav = document.querySelector('.nav');
    if (!toggle || !nav) return;
    toggle.addEventListener('click', function () {
      var open = nav.classList.toggle('open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  })();
</script>

</body>
</html>
