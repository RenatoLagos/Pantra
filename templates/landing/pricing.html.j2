{% extends "landing/_base.html.j2" %}

{% block title %}{{ t('pricing.meta.title') }}{% endblock %}

{% block meta_description %}{{ t('pricing.meta.description') }}{% endblock %}

{% block content %}

{# ════════════════════════════════════════════════════════════
   1. PRICING HEADER — smaller than /einzelpraxis (no display-mega here;
   this page is comparative, not emotional outbound destination).
   ════════════════════════════════════════════════════════════ #}
<section style="padding: 80px 0 32px;">
  <div class="container">
    <div class="section-eyebrow">
      {{ t('pricing.header.eyebrow') }}
    </div>
    <h1 class="section-heading" style="font-size: 56px; letter-spacing: -2.5px; max-width: 900px;">
      {{ t('pricing.header.title') }}
    </h1>
    <p class="section-intro" style="font-size: 20px; max-width: 720px;">
      {{ t('pricing.header.subtitle') }}
    </p>
  </div>
</section>

{# ════════════════════════════════════════════════════════════
   2. 3-UP PRICING COMPARISON
   ════════════════════════════════════════════════════════════ #}
<section id="pricing-tiers" style="padding: 32px 0 96px;">
  <div class="container">
    <div class="pricing-compare-grid">

      {# Card 1: Solo €149 #}
      <div class="pricing-card-compare">
        <div class="pc-tier">Solo</div>
        <p class="pc-tagline">
          {{ t('pricing.tier_solo.tagline') }}
        </p>
        <div class="pc-price">
          <span class="pc-amount">€149</span>
          <span class="pc-period">
            {{ t('pricing.tier_solo.period') }}
          </span>
        </div>
        <div class="pc-setup">
          {{ t('pricing.tier_solo.setup') }}
        </div>
        <ul class="pc-features">
          <li>
            {{ t('pricing.tier_solo.feature_lang') }}
          </li>
          <li>
            {{ t('pricing.tier_solo.feature_conversations') }}
          </li>
          <li>
            {{ t('pricing.tier_solo.feature_text_only') }}
          </li>
          <li>
            {{ t('pricing.tier_solo.feature_reminders') }}
          </li>
          <li>
            {{ t('pricing.tier_solo.feature_email_escalation') }}
          </li>
          <li>
            {{ t('pricing.tier_solo.feature_avv') }}
          </li>
          <li>
            {{ t('pricing.tier_solo.feature_frankfurt') }}
          </li>
          <li>
            {{ t('pricing.tier_solo.feature_support') }}
          </li>
        </ul>
        <div class="pc-cta">
          <a href="/einzelpraxis#get-started" class="btn-secondary" style="width: 100%; display: flex;">
            {{ t('common.nav.cta_trial') }}
          </a>
        </div>
      </div>

      {# Card 2: Solo Plus €349 (FEATURED) #}
      <div class="pricing-card-compare pc-featured">
        <div class="pc-badge">
          {{ t('pricing.tier_solo_plus.badge') }}
        </div>
        <div class="pc-tier">Solo Plus</div>
        <p class="pc-tagline">
          {{ t('pricing.tier_solo_plus.tagline') }}
        </p>
        <div class="pc-price">
          <span class="pc-amount">€349</span>
          <span class="pc-period">
            {{ t('pricing.tier_solo_plus.period') }}
          </span>
        </div>
        <div class="pc-setup">
          {{ t('pricing.tier_solo_plus.setup') }}
        </div>
        <ul class="pc-features">
          <li>
            DE + EN + <strong>{{ t('pricing.tier_solo_plus.feature_lang_choice') }}</strong>
          </li>
          <li>
            {{ t('pricing.tier_solo_plus.feature_conversations') }}
          </li>
          <li>
            {{ t('pricing.tier_solo_plus.feature_audio') }}
          </li>
          <li>
            {{ t('pricing.tier_solo_plus.feature_reminders') }}
          </li>
          <li>
            {{ t('pricing.tier_solo_plus.feature_noshow') }}
          </li>
          <li>
            {{ t('pricing.tier_solo_plus.feature_pvs') }}
          </li>
          <li>
            {{ t('pricing.tier_solo_plus.feature_escalation') }}
          </li>
          <li>
            {{ t('pricing.tier_solo_plus.feature_avv_frankfurt') }}
          </li>
          <li>
            {{ t('pricing.tier_solo_plus.feature_support') }}
          </li>
        </ul>
        <div class="pc-cta">
          <a href="/einzelpraxis#get-started" class="btn-primary" style="width: 100%; display: flex;">
            {{ t('common.nav.cta_trial') }}
          </a>
        </div>
      </div>

      {# Card 3: Multi (coming soon) #}
      <div class="pricing-card-compare pc-coming-soon">
        <div class="pc-badge pc-badge-soft">
          {{ t('pricing.tier_multi.badge') }}
        </div>
        <div class="pc-tier">Multi</div>
        <p class="pc-tagline">
          {{ t('pricing.tier_multi.tagline') }}
        </p>
        <div class="pc-price">
          <span class="pc-amount">
            {{ t('pricing.tier_multi.price_from') }}
          </span>
          <span class="pc-period">
            {{ t('pricing.tier_multi.period') }}
          </span>
        </div>
        <div class="pc-setup">
          {{ t('pricing.tier_multi.setup') }}
        </div>
        <ul class="pc-features">
          <li>
            {{ t('pricing.tier_multi.feature_everything') }}
          </li>
          <li>
            {{ t('pricing.tier_multi.feature_dentists') }}
          </li>
          <li>
            {{ t('pricing.tier_multi.feature_triage') }}
          </li>
          <li>
            {{ t('pricing.tier_multi.feature_services') }}
          </li>
          <li>
            {{ t('pricing.tier_multi.feature_dashboards') }}
          </li>
          <li>
            {{ t('pricing.tier_multi.feature_account_manager') }}
          </li>
        </ul>
        <div class="pc-cta">
          <a href="mailto:hallo@pantra.de?subject=Multi%20Praxis%20Frühzugang" class="btn-secondary" style="width: 100%; display: flex;">
            {{ t('pricing.tier_multi.cta') }}
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

{# ════════════════════════════════════════════════════════════
   3. ADD-ONS
   ════════════════════════════════════════════════════════════ #}
<section id="addons">
  <div class="container">
    <div class="section-eyebrow">{{ t('pricing.addons.eyebrow') }}</div>
    <h2 class="section-heading">
      {{ t('pricing.addons.heading') }}
    </h2>

    <div class="addons-grid">
      <div class="addon-card">
        <div class="addon-icon">🌍</div>
        <h3>
          {{ t('pricing.addons.lang_title') }}
        </h3>
        <div class="addon-price">{{ t('pricing.addons.lang_price') }}</div>
        <p>
          {{ t('pricing.addons.lang_desc') }}
        </p>
      </div>
      <div class="addon-card">
        <div class="addon-icon">🤝</div>
        <h3>
          {{ t('pricing.addons.onboarding_title') }}
        </h3>
        <div class="addon-price">
          {{ t('pricing.addons.onboarding_price') }}
        </div>
        <p>
          {{ t('pricing.addons.onboarding_desc') }}
        </p>
      </div>
      <div class="addon-card">
        <div class="addon-icon">📊</div>
        <h3>
          {{ t('pricing.addons.overage_title') }}
        </h3>
        <div class="addon-price">
          {{ t('pricing.addons.overage_price') }}
        </div>
        <p>
          {{ t('pricing.addons.overage_desc') }}
        </p>
      </div>
      <div class="addon-card">
        <div class="addon-icon">💰</div>
        <h3>
          {{ t('pricing.addons.annual_title') }}
        </h3>
        <div class="addon-price">
          {{ t('pricing.addons.annual_price') }}
        </div>
        <p>
          {{ t('pricing.addons.annual_desc') }}
        </p>
      </div>
    </div>
  </div>
</section>

{# ════════════════════════════════════════════════════════════
   4. LIMITS EXPLAINER — clarify hard limits + excedente
   ════════════════════════════════════════════════════════════ #}
<section>
  <div class="container">
    <div class="limits-band">
      <div>
        <h3>
          {{ t('pricing.limits.heading') }}
        </h3>
        <p style="margin-bottom: 16px;">
          {{ t('pricing.limits.p1') }}
        </p>
        <p>
          {{ t('pricing.limits.p2') }}
        </p>
      </div>
      <div class="limits-table">
        <div class="limits-row">
          <div class="limits-label">
            {{ t('pricing.limits.solo_label') }}
          </div>
          <div class="limits-value">{{ t('pricing.limits.solo_value') }}</div>
        </div>
        <div class="limits-row">
          <div class="limits-label">
            {{ t('pricing.limits.solo_plus_label') }}
          </div>
          <div class="limits-value">{{ t('pricing.limits.solo_plus_value') }}</div>
        </div>
        <div class="limits-row">
          <div class="limits-label">
            {{ t('pricing.limits.overage_label') }}
          </div>
          <div class="limits-value">{{ t('pricing.limits.overage_value') }}</div>
        </div>
        <div class="limits-row">
          <div class="limits-label">
            {{ t('pricing.limits.avg_label') }}
          </div>
          <div class="limits-value">
            {{ t('pricing.limits.avg_value') }}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

