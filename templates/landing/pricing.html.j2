{# ════════════════════════════════════════════════════════════
   6. TRUST BLOCK (compact) — reuse the 4-badge pattern
   ════════════════════════════════════════════════════════════ #}
<section>
  <div class="container">
    <h2 class="section-heading">
      {{ t('pricing.trust.heading') }}
    </h2>

    <div class="trust-grid">
      <div class="trust-card">
        <div class="trust-card-icon">🛡️</div>
        <div class="trust-card-title">{{ t('common.trust.dsgvo') }}</div>
        <p class="trust-card-desc">
          {{ t('pricing.trust.dsgvo_desc') }}
        </p>
      </div>
      <div class="trust-card">
        <div class="trust-card-icon">📄</div>
        <div class="trust-card-title">{{ t('pricing.trust.avv_title') }}</div>
        <p class="trust-card-desc">
          {{ t('pricing.trust.avv_desc') }}
        </p>
      </div>
      <div class="trust-card">
        <div class="trust-card-icon">🇩🇪</div>
        <div class="trust-card-title">{{ t('pricing.trust.frankfurt_title') }}</div>
