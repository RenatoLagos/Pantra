{# ════════════════════════════════════════════════════════════
   7. FINAL CTA — narrative-style, drives to /einzelpraxis trial
   ════════════════════════════════════════════════════════════ #}
<section style="padding-bottom: 128px;">
  <div class="container">
    <div class="testimonial-slab" style="text-align: center;">
      <h3 style="margin: 0 auto 32px;">
        {{ t('pricing.cta.heading') }}
      </h3>
      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <a href="/einzelpraxis#get-started" class="btn-light-pill">
          {{ t('common.nav.cta_trial') }}
        </a>
        <a href="/einzelpraxis" class="btn-secondary" style="border-color: var(--on-primary); color: var(--on-primary);">
          {{ t('pricing.cta.cta_learn_more') }}
        </a>
      </div>
    </div>
  </div>
</section>

{% endblock %}
