<section id="get-started" style="padding: 0;">
  <div class="get-started-band">
    <div>
      <h3>
        {{ t('einzelpraxis.cta.heading') }}
      </h3>
      <p class="lead">
        {{ t('einzelpraxis.cta.lead') }}
      </p>
      <p class="get-started-meta">
        {{ t('einzelpraxis.cta.meta') }}
      </p>
    </div>
    <form class="get-started-form" id="trial-form" method="post" action="/api/leads/trial">
      <input class="form-input-on-sage" type="text" name="contact_name" placeholder="{{ t('einzelpraxis.form.placeholder_name') }}" required>
      <input class="form-input-on-sage" type="text" name="clinic_name" placeholder="{{ t('einzelpraxis.form.placeholder_clinic') }}" required>
      <input class="form-input-on-sage" type="email" name="email" placeholder="{{ t('einzelpraxis.form.placeholder_email') }}" required>
      <input class="form-input-on-sage" type="tel" name="phone" placeholder="{{ t('einzelpraxis.form.placeholder_phone') }}">

      <label class="form-checkbox-row">
        <input type="checkbox" name="consent_dsgvo" required>
        <span>
          {{ t('einzelpraxis.cta.consent_prefix') }} <a href="/datenschutz">{{ t('einzelpraxis.cta.consent_link') }}</a>{{ t('einzelpraxis.cta.consent_suffix') }}
        </span>
      </label>

      <button type="submit" class="btn-light-pill">
        {{ t('einzelpraxis.cta.submit') }}
      </button>

      <div class="form-status" id="form-status"></div>
    </form>
  </div>
</section>

{# Inline form-handling JS — tiny, no framework. Submits via fetch and shows
   inline status. Falls back to native submit if JS is disabled. #}
<script>
(function() {
  const form = document.getElementById('trial-form');
  if (!form) return;
  const status = document.getElementById('form-status');
  var MSG_SUCCESS = {{ t('einzelpraxis.form.success') | tojson }};
  var MSG_ERROR_GENERIC = {{ t('einzelpraxis.form.error_generic') | tojson }};
  var MSG_ERROR_NETWORK = {{ t('einzelpraxis.form.error_network') | tojson }};

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.className = 'form-status';
    status.textContent = '';

    const data = Object.fromEntries(new FormData(form));
    data.consent_dsgvo = !!data.consent_dsgvo;
    data.source = 'einzelpraxis';

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (res.ok) {
        status.className = 'form-status success';
        status.textContent = MSG_SUCCESS;
        form.reset();
      } else {
        const err = await res.json().catch(() => ({}));
        status.className = 'form-status error';
        status.textContent = err.detail || MSG_ERROR_GENERIC;
      }
    } catch (err) {
      status.className = 'form-status error';
      status.textContent = MSG_ERROR_NETWORK;
    }
  });
})();
</script>

